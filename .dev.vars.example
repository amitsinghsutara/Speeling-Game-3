# Copy to .dev.vars (git-ignored) for `npm run dev:full`.
ADVISER_ENABLED=true
GEMINI_MODEL=mock-model
# Fake key for the local mock. For real Gemini, put your own key here and remove GEMINI_API_BASE.
GEMINI_API_KEY=local-test-not-a-real-key
# Local testing only: send requests to `npm run mock:gemini` instead of Google.
GEMINI_API_BASE=http://127.0.0.1:8790
